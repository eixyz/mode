{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "mozambique-embassy-mcp",
      "version": "0.1.0",
      "title": "Mozambique Embassy (Germany) MCP"
    },
    "tools": [
      {
        "name": "embassy_info",
        "title": "Embassy contact & services",
        "description": "Return contact details, opening hours, and the list of consular services offered by the Embassy of Mozambique in Germany.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_news",
        "title": "List embassy news",
        "description": "Return the list of published news articles from the Embassy of Mozambique in Germany. Optionally filter by category (e.g. 'Visa', 'Trade', 'Culture', 'Announcement').",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "category": {
              "description": "Optional category filter (case-insensitive).",
              "type": "string"
            },
            "limit": {
              "description": "Max number of items to return.",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_news",
        "title": "Get news article",
        "description": "Return the full content of a single embassy news article by id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "The news article id (from list_news)."
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_events",
        "title": "List embassy events",
        "description": "Return upcoming events hosted or organized by the Embassy of Mozambique in Germany. Optionally filter by category and limit results.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "category": {
              "description": "Optional category filter (e.g. 'Culture', 'Trade').",
              "type": "string"
            },
            "limit": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "upcomingOnly": {
              "description": "If true, only return events with a date today or later.",
              "type": "boolean"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_event",
        "title": "Get event",
        "description": "Return the full details of a single embassy event by id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "The event id (from list_events)."
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
